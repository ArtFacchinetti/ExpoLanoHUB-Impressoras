# IP de uma impressora que responde a SNMP v2c nesta rede.
SNMP_HOST=192.168.0.51
SNMP_PORT=161
SNMP_COMMUNITY=public
SNMP_TIMEOUT_MS=2000
SNMP_RETRIES=1
PRINTER_HOSTS=192.168.0.51
PRINTER_FAST_INTERVAL=30
PRINTER_NORMAL_INTERVAL=300
PRINTER_MAX_CONCURRENCY=5

# Banco local. A aplicação em Docker usa o hostname interno "db".
POSTGRES_USER=ti_hub
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=ti_hub
DATABASE_URL=postgresql://ti_hub:change-me-local@127.0.0.1:5433/ti_hub?schema=public
